    "「%@」的模型、标注和照片都会被删除，无法恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model, notes and photos of “%@” will be deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán el modelo, las notas y las fotos de «%@». No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のモデル、注記、写真はすべて削除され、元に戻せません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的模型、標註和照片都會被刪除，無法復原。"
          }
        }
      }
    },
