    "慢慢移动手机，对准墙角、门和窗。停一下就会自动拍照": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move slowly and aim at corners, doors and windows. Hold still to take a photo automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete despacio y apunta a esquinas, puertas y ventanas. Quédate quieto para hacer una foto automática"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり動かして、部屋の角・ドア・窓に向けてください。止まると自動で撮影します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢移動手機，對準牆角、門和窗。停一下就會自動拍照"
          }
        }
      }
