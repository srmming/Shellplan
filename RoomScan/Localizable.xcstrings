    "点墙查看尺寸、填实测值；点蓝色图钉看备注。单位 mm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a wall for its size or to add a measured value; tap a blue pin to see a note. Units: mm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una pared para ver su medida o añadir la real; toca un pin azul para ver una nota. Unidades: mm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁をタップで寸法の確認や実測値の入力、青いピンでメモを表示。単位 mm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點牆查看尺寸、填實測值；點藍色圖釘看備註。單位 mm"
          }
        }
      }
    },
