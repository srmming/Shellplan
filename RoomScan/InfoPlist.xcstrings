  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 装修底图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 裝修底圖"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shellplan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Shellplan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shellplan"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 LiDAR 扫描房间，以及给标注位置拍照"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於 LiDAR 掃描房間，以及為標註位置拍照"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan rooms with LiDAR and to take photos for your notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para escanear habitaciones con LiDAR y tomar fotos para tus notas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR で部屋をスキャンし、メモ用の写真を撮影するためにカメラを使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于从相册选择照片附加到备注"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於從相簿選擇照片附加到備註"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos you choose from your library are attached to your notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos que elijas de tu fototeca se adjuntan a tus notas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリから選んだ写真をメモに添付するために使用します。"
          }
        }
      }
    }
  }
}